# Copy to .env and fill in local values. Keep .env private.
SECRET_KEY=
# Local HTTP demonstration. Set APP_ENV=production for an HTTPS deployment.
APP_ENV=development
SESSION_COOKIE_SECURE=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_boarding_db
DB_USER=smart_boarding_app
DB_PASSWORD=

# SMTP for registration, OTP, password recovery, and billing notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

APP_PUBLIC_URL=http://127.0.0.1:5000
AUTH_SESSION_STORE_ENABLED=1
ADMIN_PORTAL_ENABLED=1
ACCOUNT_REACTIVATION_ENABLED=1
ACCOUNT_REACTIVATION_RETRY_ENABLED=1
TENANT_REMOVAL_REQUESTS_ENABLED=1
STUDENT_SETTINGS_ENABLED=1
MAINTENANCE_PHOTOS_ENABLED=1
BILLING_REDESIGN_ENABLED=1
SHARED_EXPENSE_BILLING_ENABLED=1
PAYMENT_MAX_UPLOAD_BYTES=5242880

# Enable only after a phone-reachable HTTPS upload gateway is configured.
MOBILE_SLIP_ENABLED=0
MOBILE_PUBLIC_BASE_URL=
MOBILE_TRUST_LOCAL_PROXY=0
